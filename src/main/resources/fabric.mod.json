{
  "schemaVersion": 1,
  "id": "progressionmod",
  "version": "${version}",
  "name": "Progression Overhaul",
  "description": "A complete progression overhaul starting from Flint tools.",
  "authors": [
    "Arc360"
  ],
  "contact": {},
  "license": "MIT",
  "icon": "assets/progressionmod/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.progressionmod.ProgressionMod"
    ],
    "client": [
      "com.progressionmod.ProgressionModClient"
    ],
    "modmenu": [
      "com.progressionmod.ModMenuIntegration"
    ],
    "jade": [
      "com.progressionmod.jade.JadePlugin"
    ],
    "neocraft_ui:hud": [
      "com.progressionmod.client.compat.NeoCraftHudCompat"
    ]
  },
  "accessWidener": "progressionmod.accesswidener",
  "mixins": [
    "progressionmod.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version_range}"
  },
  "suggests": {
    "jade": "*",
    "neocraft_ui": "*"
  }
}
